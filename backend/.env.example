# Puerto del servidor Express
PORT=3000

# Conexión con MySQL de XAMPP (ajustar según la instalación local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dulces_lucho

# Clave privada de ImgBB: colocarla solo en backend/.env, nunca en Git
IMGBB_API_KEY=PEGAR_AQUI_LA_CLAVE_NUEVA_DE_IMGBB

# Código secreto validado exclusivamente por el backend (no colocarlo en la app móvil)
ADMIN_REGISTRATION_CODE=CAMBIAR_POR_UN_CODIGO_SECRETO
