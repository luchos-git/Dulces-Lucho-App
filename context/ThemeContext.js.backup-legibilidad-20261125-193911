export function getThemeColors() {
  return TEMAS[temaActivo] || TEMAS.claro;
}

function convertirColor(valor, propiedad) {
  if (typeof valor !== 'string') return valor;
  const normalizado = valor.trim().toLowerCase();
  if (normalizado === '#e3f2fd' && String(propiedad).toLowerCase() === 'color') return temaActivo === 'oscuro' ? getThemeColors().text : '#FFFFFF';
  if (normalizado === '#fff' || normalizado === '#ffffff' || normalizado === 'white') {
    const prop = String(propiedad).toLowerCase();
    if (prop === 'color' || prop === 'tintcolor') return '#FFFFFF';
    if (prop.includes('background')) return getThemeColors().surface;
    if (prop.includes('border')) return getThemeColors().border;
  }
  if ((normalizado === '#000' || normalizado === '#000000' || normalizado === 'black')
      && ['color', 'tintcolor'].includes(String(propiedad).toLowerCase())) return getThemeColors().text;
  const clave = MAPA_COLORES[normalizado];
  if (clave) return getThemeColors()[clave];

  // En modo oscuro, muchos textos antiguos tienen marrones/negros escritos
  // directamente en hexadecimal. Si no están en el mapa semántico y son
  // demasiado oscuros, se sustituyen por el color de texto del tema.
  const propiedadNormalizada = String(propiedad).toLowerCase();
  if (temaActivo === 'oscuro' && ['color', 'tintcolor'].includes(propiedadNormalizada)) {
    const hex = normalizado.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
    if (hex) {
      let valorHex = hex[1];
      if (valorHex.length === 3) valorHex = valorHex.split('').map((caracter) => caracter + caracter).join('');
      const canales = [0, 2, 4].map((indice) => parseInt(valorHex.slice(indice, indice + 2), 16) / 255);
      const lineal = canales.map((canal) => canal <= 0.04045 ? canal / 12.92 : ((canal + 0.055) / 1.055) ** 2.4);
      const luminancia = 0.2126 * lineal[0] + 0.7152 * lineal[1] + 0.0722 * lineal[2];
      if (luminancia < 0.30) return getThemeColors().text;
    }
  }
  return valor;
}

// Conserva los estilos originales, pero resuelve sus colores con el tema activo.
// Así no es necesario duplicar cada hoja de estilos para cada apariencia.
export function createThemedStyles(definicion) {
  const base = StyleSheet.create(definicion);
  return new Proxy({}, {
    get(_target, propiedad) {
      const estilo = base[propiedad];
      if (!estilo || typeof estilo !== 'object' || Array.isArray(estilo)) return estilo;
      const resultado = {};
      Object.keys(estilo).forEach((clave) => {
        resultado[clave] = typeof estilo[clave] === 'string'
          ? convertirColor(estilo[clave], clave)
          : estilo[clave];
      });
      const contieneTipografia = ['fontSize', 'fontWeight', 'fontStyle', 'lineHeight', 'letterSpacing', 'textAlign', 'textTransform', 'textDecorationLine'].some((prop) => prop in estilo);
      const esCampoTexto = /input|textinput|fieldtext/i.test(String(propiedad));
      if ((contieneTipografia || esCampoTexto) && !('color' in resultado)) {
        resultado.color = getThemeColors().text;
      }
      return resultado;
    },
  });
}

const ThemeContext = createContext({
  themeName: 'claro',
  colors: TEMAS.claro,
  cambiarTema: async () => {},
});

export function ThemeProvider({ children }) {
  const [themeName, setThemeName] = useState('claro');
  const [cargado, setCargado] = useState(false);

  useEffect(() => {
    let vigente = true;
    AsyncStorage.getItem(CLAVE_TEMA)
      .then((guardado) => {
        if (vigente && TEMAS[guardado]) setThemeName(guardado);
      })
      .catch((error) => console.warn('No se pudo recuperar la apariencia:', error.message))
      .finally(() => { if (vigente) setCargado(true); });
    return () => { vigente = false; };
  }, []);

  temaActivo = themeName;
  // Se asigna antes de renderizar las pantallas para que también los <Text>
  // sin style explícito respeten el color de la apariencia seleccionada.
  NativeText.defaultProps = {
    ...(NativeText.defaultProps || {}),
    style: [ESTILO_DEFAULT_TEXTO, { color: TEMAS[themeName].text }],
  };

  const cambiarTema = useCallback(async (nuevoTema) => {
    if (!TEMAS[nuevoTema]) return;
    temaActivo = nuevoTema;
    setThemeName(nuevoTema);
    try {
      await AsyncStorage.setItem(CLAVE_TEMA, nuevoTema);
    } catch (error) {
      console.warn('No se pudo guardar la apariencia:', error.message);
    }
  }, []);

  const value = useMemo(() => ({ themeName, colors: TEMAS[themeName], cambiarTema, cargado }), [themeName, cambiarTema, cargado]);

  return (
    <ThemeContext.Provider value={value}>
      <StatusBar style={themeName === 'oscuro' ? 'light' : 'dark'} backgroundColor={TEMAS[themeName].background} />
      {children}
    </ThemeContext.Provider>
  );
}


// Convierte cualquier color de texto oscuro a un tono legible en modo oscuro.
// Incluye hexadecimal, rgb()/rgba() y nombres básicos, incluso si el color
// viene de un estilo inline antiguo y no de createThemedStyles.
function luminanciaColor(valor) {
  if (typeof valor !== 'string') return null;
  const color = valor.trim().toLowerCase();
  if (['black', 'darkgray', 'darkgrey', 'dimgray', 'dimgrey', 'navy'].includes(color)) return 0.04;
  if (['white', 'whitesmoke'].includes(color)) return 1;
  let canales = null;
  const hex = color.match(/^#([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i);
  if (hex) {
    let raw = hex[1];
    if (raw.length === 3 || raw.length === 4) raw = raw.slice(0, 3).split('').map((c) => c + c).join('');
    else raw = raw.slice(0, 6);
    canales = [0, 2, 4].map((i) => parseInt(raw.slice(i, i + 2), 16));
  } else {
    const rgb = color.match(/^rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})/);
    if (rgb) canales = [Number(rgb[1]), Number(rgb[2]), Number(rgb[3])];
  }
  if (!canales) return null;
  const lineales = canales.map((canal) => {
    const normal = Math.max(0, Math.min(255, canal)) / 255;
    return normal <= 0.04045 ? normal / 12.92 : ((normal + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * lineales[0] + 0.7152 * lineales[1] + 0.0722 * lineales[2];
}

function colorTextoLegible(color, colors, themeName) {
  if (!color) return colors.text;
  if (themeName !== 'oscuro') return color;
  const luminancia = luminanciaColor(color);
  // Umbral deliberadamente generoso para evitar grises, negros y marrones
  // que se pierden sobre las superficies oscuras.
  if (luminancia !== null && luminancia < 0.42) return colors.text;
  return color;
}

export function ThemedText({ style, ...props }) {
  const { colors, themeName } = useAppTheme();
  const plano = StyleSheet.flatten(style) || {};
  const color = colorTextoLegible(plano.color, colors, themeName);
  return <NativeText {...props} style={[style, { color }]} />;
}

export function ThemedTextInput({ style, placeholderTextColor, selectionColor, ...props }) {
  const { colors, themeName } = useAppTheme();
  const plano = StyleSheet.flatten(style) || {};
  const color = colorTextoLegible(plano.color, colors, themeName);
  return (
    <NativeTextInput
      {...props}
      placeholderTextColor={colorTextoLegible(placeholderTextColor, colors, themeName) === colors.text ? colors.placeholder : (placeholderTextColor || colors.placeholder)}
      selectionColor={selectionColor || colors.primary}
      style={[style, { color }]}
    />
  );
}

export function useAppTheme() {
  return useContext(ThemeContext);
}

// Fuerza el refresco de las pantallas registradas cuando cambia la apariencia.
export function withThemeRefresh(Component) {
  function PantallaConTema(props) {
    useAppTheme();
    return <Component {...props} />;
  }
  PantallaConTema.displayName = `ConTema(${Component.displayName || Component.name || 'Pantalla'})`;
  return PantallaConTema;
}
